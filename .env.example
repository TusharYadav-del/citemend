# Copy these public project settings from Supabase into .env.local.
# Never use a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Server-only Google AI Studio key. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
