# Copy these public project settings from Supabase into .env.local.
# Never use a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Server-only Google AI Studio key. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Development-only database saves. Keep this server key out of browser code.
SUPABASE_SECRET_KEY=

# Day 5 citation provider. Keep both keys server-only.
GROQ_API_KEY=
TAVILY_API_KEY=
# Optional model override when the selected Groq model is unavailable.
GROQ_MODEL=openai/gpt-oss-120b
