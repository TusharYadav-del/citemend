# Copy to .env.local and replace placeholders. Never commit real credentials.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Legacy alternative to the publishable key (leave empty for new projects).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-secret-key
# Legacy alternative to SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Required to encrypt CMS access tokens before storing them in cms_connections.
# Generate a private value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHOPIFY_TOKEN_ENCRYPTION_KEY=replace_with_a_private_32_byte_base64_key

# Active server-only AI providers.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=your-tavily-key
# URL embeddings (the Groq/Tavily citation probe is unchanged).
# text-embedding-004 was retired; gemini-embedding-001 supports 768 dimensions.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=your-gemini-key
GEMINI_PROMPT_MODEL=gemini-2.5-flash
GEMINI_PROMPT_FALLBACK_MODEL=gemini-3.6-flash

# Optional configurable model profile registry (server-only).
CITEMEND_PERPLEXITY_PROFILE_MODEL=openai/gpt-oss-20b
CITEMEND_GOOGLE_GEMINI_MODEL=gemini-3.8-flash
CITEMEND_CLAUDE_PROFILE_MODEL=openai/gpt-oss-20b
CITEMEND_CHATGPT_SEARCH_TIMEOUT_MS=45000
CITEMEND_PERPLEXITY_PROFILE_TIMEOUT_MS=6000
CITEMEND_GOOGLE_GEMINI_TIMEOUT_MS=5000
CITEMEND_CLAUDE_PROFILE_TIMEOUT_MS=6000
# Operator-maintained estimated USD cost per model invocation; leave blank until set.
CITEMEND_MODEL_COST_CHATGPT_SEARCH_USD_PER_CALL=
CITEMEND_MODEL_COST_PERPLEXITY_SONAR_USD_PER_CALL=
CITEMEND_MODEL_COST_GOOGLE_GEMINI_USD_PER_CALL=
CITEMEND_MODEL_COST_CLAUDE_USD_PER_CALL=

# Optional internal aggregate metrics endpoint authentication.
FOUNDER_METRICS_SECRET=

# Optional local browser-test server override. NODE_ENV is managed by Next.js.
PLAYWRIGHT_BASE_URL=http://localhost:3108

# Optional development fallback: database (default) or local (never claims saved).
AUDIT_PERSISTENCE_MODE=database

# Lemon Squeezy billing (server-only).
# Invited Clerk primary emails; empty means signed-in users join the approval waitlist.
BETA_INVITED_EMAILS=
# Explicitly enable live billing later with a checkout URL or this flag.
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_LIVE_BILLING_ENABLED=false
# The LEMONSQUEEZY_* spelling without underscores is also accepted.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRODUCT_ID=
LEMON_SQUEEZY_VARIANT_ID=
# Agency monthly variant. Default is 2336501; use a separate test variant in development when needed.
LEMON_SQUEEZY_AGENCY_VARIANT_ID=2336501
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
# Development only. When true, authenticated checkout creates a Lemon Squeezy test-mode session.
LEMON_SQUEEZY_TEST_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Weekly cron (server-only). Use the same secret in Vercel, the Edge Function,
# and Supabase Vault. The prompt is a fallback for older audits without one.
CRON_SECRET=
WEEKLY_SCAN_PROMPT=

# Restrict the internal Founder Operating System route to these Clerk user IDs.
# Comma-separated; leave unset to disable the founder cockpit.
CITEMEND_FOUNDER_USER_IDS=

# Weekly Pro email digests (server-only). Sender must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@your-verified-domain.com
SUPPORT_NOTIFICATION_EMAIL=

# Citation Capsule generation; text embeddings keep their independent model.
GEMINI_CAPSULE_MODEL=gemini-3.8-flash
# One explicit fallback for unavailable/gateway errors; set to none to disable.
GEMINI_CAPSULE_FALLBACK_MODEL=gemini-3.6-flash
# Optional independent export-token key; defaults to a purpose-derived Clerk secret.
CAPSULE_SIGNING_SECRET=

# Gross-margin planning assumptions (USD per profile invocation).
# Defaults are conservative budgets; override from provider invoices/usage data.
CITEMEND_MODEL_COST_CHATGPT_SEARCH_USD_PER_CALL=0.012
CITEMEND_MODEL_COST_PERPLEXITY_SONAR_USD_PER_CALL=0.001
CITEMEND_MODEL_COST_GOOGLE_GEMINI_USD_PER_CALL=0.014
CITEMEND_MODEL_COST_CLAUDE_USD_PER_CALL=0.001
# Estimated shared crawler/hosting budget per audit, used for gross-margin quota checks.
CITEMEND_ESTIMATED_INFRA_COST_PER_AUDIT_USD=0.25
# Reference planning conversion (adjust to your finance team's approved rate).
# Default uses the RBI USD/INR reference rate for 2026-11-05, rounded to 94.4.
CITEMEND_ESTIMATED_INR_PER_USD=94.4

# Optional case-study pipeline estimate. Leave blank to show measured visits only.
# Set only when your team has an approved planning assumption; this is never revenue.
CASE_STUDY_PIPELINE_VALUE_PER_VISIT_USD=
