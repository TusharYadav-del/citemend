{
  "name": "citemend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --max-old-space-size=4096 --require ./scripts/test-userinfo-fallback.cjs --conditions=react-server --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:seo": "node --conditions=react-server --import tsx --test tests/seo.test.ts",
    "test:audit": "node --conditions=react-server --import tsx --test tests/audit.test.ts",
    "test:dashboard": "node --import tsx --test tests/dashboard.test.ts",
    "test:ui": "playwright test",
    "test:security": "node --conditions=react-server --import tsx --test tests/public-http.test.ts",
    "dev:simulate-webhooks": "node --conditions=react-server --import tsx scripts/simulate-subscription-webhook.ts",
    "dev:verify-checkout": "node --env-file=.env.local --conditions=react-server --import tsx scripts/verify-test-checkout.ts",
    "dev:verify-email": "node --env-file=.env.local --conditions=react-server --import tsx scripts/verify-test-email.ts",
    "dev:verify-cron": "node --env-file=.env.local --conditions=react-server --import tsx scripts/verify-local-cron.ts",
    "dev:index-sitemap": "node --env-file=.env.local --conditions=react-server --import tsx scripts/index-domain-sitemap.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.23",
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "fast-xml-parser": "^5.11.2",
    "groq-sdk": "^1.6.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-pgvector": "^0.0.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@google/genai@2.32.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
